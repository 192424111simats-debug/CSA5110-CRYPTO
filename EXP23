def xor(a, b):
    return ''.join('1' if x != y else '0'
                   for x, y in zip(a, b))


def encrypt_block(block, key):
    return xor(block, key)


plaintext = input("Enter 24-bit Plaintext: ")
key = input("Enter 8-bit Key: ")

counter = 0
ciphertext = ""

for i in range(0, len(plaintext), 8):

    block = plaintext[i:i+8]

    counter_bits = format(counter, '08b')

    keystream = encrypt_block(counter_bits, key)

    cipher = xor(block, keystream)

    ciphertext += cipher

    counter += 1

print("\nCiphertext:", ciphertext)

# Decryption
counter = 0
decrypted = ""

for i in range(0, len(ciphertext), 8):

    block = ciphertext[i:i+8]

    counter_bits = format(counter, '08b')

    keystream = encrypt_block(counter_bits, key)

    plain = xor(block, keystream)

    decrypted += plain

    counter += 1

print("Decrypted:", decrypted)
