from Crypto.Cipher import AES
from Crypto.Random import get_random_bytes
from Crypto.Util.Padding import pad

key = get_random_bytes(16)
iv = get_random_bytes(16)

plaintext = b"Block-1-Data!!!Block-2-Data!!!Block-3-Data!!!"

plaintext = pad(plaintext, 16)

print("Original Plaintext:")
print(plaintext)

# CBC encryption
cipher = AES.new(key, AES.MODE_CBC, iv)
ciphertext = cipher.encrypt(plaintext)

print("\nOriginal Ciphertext:")
print(ciphertext.hex())

# Introduce one-bit error in C1
modified = bytearray(ciphertext)
modified[0] ^= 1

print("\nModified Ciphertext:")
print(bytes(modified).hex())

# CBC decryption
decipher = AES.new(key, AES.MODE_CBC, iv)
decrypted = decipher.decrypt(bytes(modified))

print("\nDecrypted Result after Error:")
print(decrypted)
