# DES Key Structure

key = "133457799BBCDFF1"

PC1 = [
    57,49,41,33,25,17,9,
    1,58,50,42,34,26,18,
    10,2,59,51,43,35,27,
    19,11,3,60,52,44,36,
    63,55,47,39,31,23,15,
    7,62,54,46,38,30,22,
    14,6,61,53,45,37,29,
    21,13,5,28,20,12,4
]

def hex_to_bin(hex_string):
    return bin(int(hex_string, 16))[2:].zfill(64)


def permute(bits, table):
    return ''.join(bits[i - 1] for i in table)


key_binary = hex_to_bin(key)

key_56 = permute(key_binary, PC1)

C0 = key_56[:28]
D0 = key_56[28:]

print("Original Key:")
print(key)

print("\n56-bit Key:")
print(key_56)

print("\nC0 (28 bits):")
print(C0)

print("\nD0 (28 bits):")
print(D0)

print("\nC0 length:", len(C0))
print("D0 length:", len(D0))
