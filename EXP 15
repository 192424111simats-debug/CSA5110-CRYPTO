from collections import Counter

english_frequency = {
    'A': 8.167,
    'B': 1.492,
    'C': 2.782,
    'D': 4.253,
    'E': 12.702,
    'F': 2.228,
    'G': 2.015,
    'H': 6.094,
    'I': 6.966,
    'J': 0.153,
    'K': 0.772,
    'L': 4.025,
    'M': 2.406,
    'N': 6.749,
    'O': 7.507,
    'P': 1.929,
    'Q': 0.095,
    'R': 5.987,
    'S': 6.327,
    'T': 9.056,
    'U': 2.758,
    'V': 0.978,
    'W': 2.360,
    'X': 0.150,
    'Y': 1.974,
    'Z': 0.074
}


def decrypt(ciphertext, key):
    plaintext = ""

    for ch in ciphertext:
        if ch.isalpha():
            base = ord('A')
            value = (ord(ch.upper()) - base - key) % 26
            plaintext += chr(value + base)
        else:
            plaintext += ch

    return plaintext


def chi_square(text):
    letters = [ch for ch in text.upper() if ch.isalpha()]
    total = len(letters)

    if total == 0:
        return float('inf')

    count = Counter(letters)
    score = 0

    for letter in english_frequency:
        expected = english_frequency[letter] * total / 100
        observed = count[letter]

        if expected > 0:
            score += ((observed - expected) ** 2) / expected

    return score


ciphertext = input("Enter Cipher Text: ")

results = []

for key in range(26):
    plaintext = decrypt(ciphertext, key)
    score = chi_square(plaintext)

    results.append((score, key, plaintext))

results.sort()

print("\nTop 10 Possible Plaintexts:")
print("--------------------------------")

for rank, (score, key, plaintext) in enumerate(results[:10], 1):
    print("\nRank:", rank)
    print("Key:", key)
    print("Score:", round(score, 2))
    print("Plaintext:", plaintext)
