import numpy as np
import math

key = np.array([
    [9, 4],
    [5, 7]
])

def encrypt(plaintext, key):
    plaintext = ''.join(ch for ch in plaintext.upper() if ch.isalpha())

    # Add X if length is odd
    if len(plaintext) % 2 != 0:
        plaintext += 'X'

    ciphertext = ""

    for i in range(0, len(plaintext), 2):
        p1 = ord(plaintext[i]) - ord('A')
        p2 = ord(plaintext[i + 1]) - ord('A')

        c1 = (key[0][0] * p1 + key[0][1] * p2) % 26
        c2 = (key[1][0] * p1 + key[1][1] * p2) % 26

        ciphertext += chr(c1 + ord('A'))
        ciphertext += chr(c2 + ord('A'))

    return plaintext, ciphertext


def mod_inverse(a, m):
    for i in range(1, m):
        if (a * i) % m == 1:
            return i
    return None


def inverse_key(key):
    a = int(key[0][0])
    b = int(key[0][1])
    c = int(key[1][0])
    d = int(key[1][1])

    determinant = (a * d - b * c) % 26
    inverse_det = mod_inverse(determinant, 26)

    if inverse_det is None:
        return None

    inverse = np.array([
        [d, -b],
        [-c, a]
    ])

    inverse = (inverse_det * inverse) % 26

    return inverse


def decrypt(ciphertext, inverse):
    plaintext = ""

    for i in range(0, len(ciphertext), 2):
        c1 = ord(ciphertext[i]) - ord('A')
        c2 = ord(ciphertext[i + 1]) - ord('A')

        p1 = (inverse[0][0] * c1 + inverse[0][1] * c2) % 26
        p2 = (inverse[1][0] * c1 + inverse[1][1] * c2) % 26

        plaintext += chr(p1 + ord('A'))
        plaintext += chr(p2 + ord('A'))

    return plaintext


# Input
message = input("Enter Plain Text: ")

plain, cipher = encrypt(message, key)

print("\nProcessed Plaintext:", plain)
print("Ciphertext:", cipher)

# Decryption
inv_key = inverse_key(key)

print("\nInverse Key:")
print(inv_key)

recovered = decrypt(cipher, inv_key)

print("\nDecrypted Text:", recovered)
